rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /links/{linkId} {
      // Qualquer pessoa pode ler (necessário para o redirecionamento)
      allow read: if true;
      
      // Qualquer pessoa pode criar e atualizar (sem login necessário)
      allow create: if true;
      allow update: if true;
      
      // Qualquer pessoa pode excluir (só aparece para quem criou via sessionId)
      allow delete: if true;
    }
  }
}
