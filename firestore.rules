rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /links/{linkId} {
      // Qualquer pessoa pode ler um link para que o redirecionamento funcione
      allow read: if true;
      
      // Apenas usuários autenticados podem criar links associados ao seu próprio UID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Apenas o dono do link pode atualizar ou excluir
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
